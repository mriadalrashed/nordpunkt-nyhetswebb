@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Nordpunkt.Models.TipsFormModel>
@using Nordpunkt.Controllers
@{
    // Sant om fältet har ett fel efter att formuläret skickats.
    bool HarFel(string falt) =>
        ViewData.ModelState.TryGetValue(falt, out var post) && post.Errors.Count > 0;
}

@using (Html.BeginUmbracoForm<TipsController>(nameof(TipsController.Skicka), FormMethod.Post, new { id = "tipsformular", novalidate = "novalidate" }))
{
    <div asp-validation-summary="ModelOnly" class="form-error" role="alert" tabindex="-1"></div>

    <div class="form-field">
        <label asp-for="Rubrik"></label>
        <input asp-for="Rubrik" autocomplete="off"
               aria-describedby="Rubrik-fel"
               aria-invalid="@(HarFel("Rubrik") ? "true" : null)" />
        <span asp-validation-for="Rubrik" id="Rubrik-fel" class="field-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="Beskrivning"></label>
        <textarea asp-for="Beskrivning" rows="8"
                  aria-describedby="Beskrivning-fel"
                  aria-invalid="@(HarFel("Beskrivning") ? "true" : null)"></textarea>
        <span asp-validation-for="Beskrivning" id="Beskrivning-fel" class="field-error"></span>
    </div>

    <fieldset class="form-group">
        <legend>Kontaktuppgifter (frivilligt)</legend>
        <p id="kontakt-hjalp" class="form-hint">
            Du behöver inte lämna namn eller e-post. Om du lämnar fälten tomma kan redaktionen inte kontakta dig med frågor om tipset.
        </p>

        <div class="form-field">
            <label asp-for="Namn"></label>
            <input asp-for="Namn" autocomplete="name"
                   aria-describedby="kontakt-hjalp Namn-fel"
                   aria-invalid="@(HarFel("Namn") ? "true" : null)" />
            <span asp-validation-for="Namn" id="Namn-fel" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Epost"></label>
            <input asp-for="Epost" type="email" autocomplete="email"
                   aria-describedby="kontakt-hjalp Epost-fel"
                   aria-invalid="@(HarFel("Epost") ? "true" : null)" />
            <span asp-validation-for="Epost" id="Epost-fel" class="field-error"></span>
        </div>
    </fieldset>
    @* Fälla för automatiska program (SCRUM-19). Dold för besökare, ska lämnas tom. *@
    <div class="honeypot" aria-hidden="true">
        <label for="Webbplats">Lämna det här fältet tomt</label>
        <input asp-for="Webbplats" tabindex="-1" autocomplete="off" />
    </div>

    <button type="submit" class="btn">Skicka tipset</button>
}

<script src="~/scripts/tipsform.js" asp-append-version="true" defer></script>
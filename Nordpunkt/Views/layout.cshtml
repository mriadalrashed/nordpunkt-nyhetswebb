@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
<!DOCTYPE html>
<html lang="sv">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@(Model?.Name) – Nordpunkt</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#innehall">Hoppa till innehållet</a>
 
    <header class="site-header">
<div class="site-header__inner">
<a class="logo" href="/">NORDPUNKT</a>
 
            <button type="button" class="menu-btn" id="menyknapp"
                    aria-expanded="false" aria-controls="huvudmeny">
                ☰ Meny
</button>
 
            <nav id="huvudmeny" class="site-nav" aria-label="Huvudmeny">
<ul>
<li><a href="/">Nyheter</a></li>
<li><a href="/tipsa-redaktionen/">Tipsa redaktionen</a></li>
</ul>
</nav>
</div>
</header>
 
    <main id="innehall" class="site-main">
        @RenderBody()
</main>
 
    <footer class="site-footer">
<div class="site-footer__inner">
<span>© Nordpunkt Nyhetsbyrå</span>
<a href="/tipsa-redaktionen/">Tipsa redaktionen</a>
</div>
</footer>
 
    <script src="~/scripts/meny.js" asp-append-version="true"></script>
</body>
</html>
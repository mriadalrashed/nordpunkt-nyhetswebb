@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.TipsaRedaktionen>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Nordpunkt.Models
@{
    Layout = "layout.cshtml";
}

<h1>@Model.Rubrik</h1>

@if (!string.IsNullOrWhiteSpace(Model.Ingress))
{
    <p class="ingress">@Model.Ingress</p>
}

<section class="personuppgifter">
    @Model.Personuppgifter
</section>

@await Html.PartialAsync("TipsForm", new TipsFormModel())
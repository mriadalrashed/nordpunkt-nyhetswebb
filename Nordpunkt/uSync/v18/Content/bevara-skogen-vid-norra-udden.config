    <huvudbild>
      <Value><![CDATA[]]></Value>
    </huvudbild>
    <ingress>
      <Value><![CDATA[Skogen vid Norra udden är en av ortens viktigaste platser för friluftsliv. Den borde skyddas.
]]></Value>
